{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredPhpVersion": "8.1",
	"preferredWordPressVersion": "latest",
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "dir",
				"path": "."
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runWordPressCLI",
			"command": "user create user1 user1@example.com --role=author --display_name='John Doe'"
		},
		{
			"step": "runWordPressCLI",
			"command": "user create user2 user2@example.com --role=editor --display_name='Jane Smith'"
		},
		{
			"step": "runWordPressCLI",
			"command": "user create user3 user3@example.com --role=contributor --display_name='Bob Johnson'"
		}
	],
	"landingPage": "/wp-admin/post-new.php?post_type=page&content=%3C!--%20wp:author-avatars/show-avatar%20/%3E"
}
